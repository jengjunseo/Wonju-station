# KMA short-range forecast and weather-alert APIs from data.go.kr (server secret).
# Obtain an encoded/decoded service key after applying for both services at data.go.kr.
# Unlocks authoritative weather/forecast and explicit Wonju alert status.
KMA_SERVICE_KEY=

# AirKorea station and real-time air-pollution APIs from data.go.kr (server secret).
# Obtain after applying for the AirKorea station + pollution OpenAPIs; production use may require AirKorea approval.
# Unlocks an official Wonju monitoring-station reading while Open-Meteo remains the fallback.
AIRKOREA_SERVICE_KEY=

# Optional shared data.go.kr service key fallback for KMA/AirKorea (server secret).
PUBLIC_DATA_SERVICE_KEY=

# Kakao Local REST API key (server secret) from developers.kakao.com.
# Unlocks evidence-backed address/district geocoding for News Map.
KAKAO_REST_API_KEY=

# Provider-designated public Kakao JavaScript app key.
# Unlocks the Kakao base map; register the deployed web domain in Kakao Developers first.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Naver Search Open API news credentials (server secrets) from developers.naver.com.
# Unlocks independent Wonju-local Naver News results alongside the official Wonju City feed.
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=

# Google AI Studio Gemini API key (server secret) from aistudio.google.com.
# Uses Google's stable gemini-3.5-flash-lite model through the server-side chat adapter.
GEMINI_API_KEY=
